---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageBySlug, getSiteSettings, urlFor } from '../../lib/sanity';

const lang = 'id';
const page = await getPageBySlug('home', lang);
const settings = await getSiteSettings(lang);
const hero = page?.hero;
---

<BaseLayout title={page?.title || 'Beranda'} lang={lang} currentPath="/id">
  {/* Hero Section Bawaan dari Sanity (Tetap Dipertahankan) */}
  <section class="max-w-6xl mx-auto px-6 pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <div class="inline-flex items-center gap-2 bg-amber-100/80 border border-amber-200 text-amber-800 text-xs font-bold px-4 py-1.5 rounded-full mb-6">
          <span>✨</span>
          <span>{hero?.badge || 'Montessori & Merdeka Belajar di Gianyar – Bali'}</span>
        </div>

        <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-slate-900 leading-[1.12] mb-6">
          {hero?.headline || 'Tempat Rasa Ingin Tahu Bertemu Kreativitas'}
        </h1>

        <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-8">
          {hero?.subheadline ||
            'Selamat datang di perjalanan pendidikan yang penuh keceriaan di mana rasa ingin tahu bertemu kreativitas, dan setiap keunikan anak dirayakan dengan sepenuh hati.'}
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href={hero?.primaryCtaUrl || '/id/programs'}
            class="rounded-full bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold text-sm px-7 py-4 shadow-md shadow-amber-400/25 transition"
          >
            {hero?.primaryCtaLabel || 'Lihat Program'}
          </a>
          <a
            href={hero?.secondaryCtaUrl || '/id/contacts'}
            class="rounded-full bg-white hover:bg-teal-50 text-teal-700 border border-teal-200 font-bold text-sm px-7 py-4 transition"
          >
            {hero?.secondaryCtaLabel || 'Jadwalkan Kunjungan'}
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="absolute -inset-3 bg-gradient-to-tr from-teal-200/60 via-amber-200/50 to-orange-200/60 rounded-[2.5rem] -rotate-2"></div>
        <div class="relative rounded-[2.2rem] overflow-hidden bg-white p-2 shadow-xl border border-amber-100">
  { (hero?.image || hero?.heroImage || page?.heroImage || page?.sections?.[0]?.image) ? (
  <img
    src={urlFor(hero?.image || hero?.heroImage || page?.heroImage || page?.sections?.[0]?.image).width(900).auto('format').url()}
    alt={hero?.headline || 'Tunas Gama School Campus'}
    class="w-full h-[340px] md:h-[420px] object-cover rounded-[1.8rem]"
  />
) : (
  <img
    src="/hero-school.jpg"
    alt="Tunas Gama School Campus"
    class="w-full h-[340px] md:h-[420px] object-cover rounded-[1.8rem]"
  />
)}
        </div>
      </div>
    </div>
  </section>

  {/* Render Section Tambahan dari Sanity jika ada */}
  {page?.sections && page.sections.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-8 space-y-12">
      {page.sections.map((section: any) => (
        <div class="bg-white rounded-[2rem] border border-amber-100 p-8 md:p-10 shadow-xs">
          {section.heading && (
            <h2 class="font-display text-2xl md:text-3xl font-bold text-slate-900 mb-3">
              {section.heading}
            </h2>
          )}
          {section.description && (
            <p class="text-slate-600 leading-relaxed mb-6">{section.description}</p>
          )}
          {section.items && section.items.length > 0 && (
            <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-5">
              {section.items.map((item: any) => (
                <div class="rounded-2xl bg-amber-50/50 border border-amber-100 p-5">
                  {item.title && <h3 class="font-display font-bold text-slate-900 mb-1">{item.title}</h3>}
                  {item.description && <p class="text-xs text-slate-600 leading-relaxed">{item.description}</p>}
                </div>
              ))}
            </div>
          )}
        </div>
      ))}
    </section>
  )}

  {/* 1. Cuplikan Tentang Kami */}
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="bg-white rounded-[2.5rem] border border-amber-100 p-8 md:p-12 shadow-sm grid md:grid-cols-2 gap-10 items-center">
      <div>
        <span class="inline-block bg-amber-100 text-amber-800 text-xs font-bold px-3.5 py-1.5 rounded-full mb-4">
          Tentang Tunas Gama School
        </span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-slate-900 mb-4 leading-tight">
          Menumbuhkan Anak yang Percaya Diri, Kreatif, dan Berkarakter
        </h2>
        <p class="text-slate-600 leading-relaxed mb-6">
          Di bawah naungan Yayasan Pakisoka di Gianyar, Bali, kami memadukan kurikulum nasional <strong>Merdeka Belajar</strong> dengan pendekatan <strong>Montessori</strong> yang hangat sehingga setiap anak berkembang sesuai potensi terbaiknya.
        </p>
        <div class="grid grid-cols-2 gap-4 mb-8">
          <div class="bg-amber-50/70 rounded-2xl p-4 border border-amber-100">
            <p class="font-display text-xl font-bold text-teal-700">Holistik</p>
            <p class="text-xs text-slate-600 mt-1">Keseimbangan karakter, kreativitas & akademik</p>
          </div>
          <div class="bg-teal-50/70 rounded-2xl p-4 border border-teal-100">
            <p class="font-display text-xl font-bold text-amber-600">Bilingual</p>
            <p class="text-xs text-slate-600 mt-1">Pembiasaan Bahasa Inggris & Bahasa Indonesia</p>
          </div>
        </div>
        <a
          href="/id/about-us"
          class="inline-flex items-center gap-2 rounded-full bg-slate-900 hover:bg-teal-700 text-white text-sm font-bold px-6 py-3 transition"
        >
          Selengkapnya Tentang Kami →
        </a>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="bg-gradient-to-br from-amber-100 to-orange-100 rounded-3xl p-6 flex flex-col justify-between min-h-[180px]">
          <span class="text-3xl">🌱</span>
          <div>
            <h3 class="font-display font-bold text-lg text-slate-800">Eksplorasi Aktif</h3>
            <p class="text-xs text-slate-600 mt-1">Media belajar interaktif yang memicu rasa ingin tahu anak.</p>
          </div>
        </div>
        <div class="bg-gradient-to-br from-teal-100 to-emerald-100 rounded-3xl p-6 flex flex-col justify-between min-h-[180px] md:mt-6">
          <span class="text-3xl">🎨</span>
          <div>
            <h3 class="font-display font-bold text-lg text-slate-800">Ekspresi Kreatif</h3>
            <p class="text-xs text-slate-600 mt-1">Seni, musik, gerak motorik, dan pengenalan budaya lokal.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 2. Cuplikan Program */}
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <span class="inline-block bg-teal-100 text-teal-800 text-xs font-bold px-3.5 py-1.5 rounded-full mb-3">
          Program Pendidikan
        </span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-slate-900">
          Jenjang Belajar Sesuai Usia Anak
        </h2>
      </div>
      <a href="/id/programs" class="text-sm font-bold text-teal-700 hover:text-amber-600 transition">
        Lihat Semua Program →
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-white rounded-3xl border border-amber-100 p-7 shadow-xs hover:shadow-md transition">
        <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center text-2xl mb-5">
          🧸
        </div>
        <h3 class="font-display text-xl font-bold text-slate-900 mb-2">Kelompok Bermain (Playgroup)</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-5">
          Stimulasi sensorik, motorik halus dan kasar, serta sosialisasi awal dalam suasana penuh keceriaan.
        </p>
        <a href="/id/programs" class="text-xs font-bold text-teal-600 hover:underline">Detail program →</a>
      </div>

      <div class="bg-white rounded-3xl border border-teal-100 p-7 shadow-xs hover:shadow-md transition">
        <div class="w-12 h-12 rounded-2xl bg-teal-100 text-teal-700 flex items-center justify-center text-2xl mb-5">
          📚
        </div>
        <h3 class="font-display text-xl font-bold text-slate-900 mb-2">Taman Kanak-Kanak (TK A & TK B)</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-5">
          Fondasi literasi, numerasi, kemandirian, dan pemecahan masalah melalui metode Montessori & Merdeka Belajar.
        </p>
        <a href="/id/programs" class="text-xs font-bold text-teal-600 hover:underline">Detail program →</a>
      </div>

      <div class="bg-white rounded-3xl border border-orange-100 p-7 shadow-xs hover:shadow-md transition">
        <div class="w-12 h-12 rounded-2xl bg-orange-100 text-orange-700 flex items-center justify-center text-2xl mb-5">
          🌏
        </div>
        <h3 class="font-display text-xl font-bold text-slate-900 mb-2">Pengembangan Karakter & Bakat</h3>
        <p class="text-sm text-slate-600 leading-relaxed mb-5">
          Eksplorasi alam terbuka, seni budaya Bali, kerja sama tim, dan pembiasaan positif sejak dini.
        </p>
        <a href="/id/programs" class="text-xs font-bold text-teal-600 hover:underline">Detail program →</a>
      </div>
    </div>
  </section>

  {/* 3. Cuplikan Kesehatan & Keselamatan */}
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="bg-teal-50/80 rounded-[2.5rem] border border-teal-100 p-8 md:p-12">
      <div class="max-w-2xl mb-8">
        <span class="inline-block bg-white text-teal-700 text-xs font-bold px-3.5 py-1.5 rounded-full mb-3 shadow-2xs">
          Kesehatan & Keselamatan
        </span>
        <h2 class="font-display text-3xl font-bold text-slate-900 mb-3">
          Lingkungan Sekolah yang Aman, Bersih, dan Nyaman
        </h2>
        <p class="text-sm md:text-base text-slate-600">
          Setiap sudut Tunas Gama School dirancang untuk memberikan rasa tenang bagi orang tua saat anak bereksplorasi.
        </p>
      </div>

      <div class="grid sm:grid-cols-3 gap-5 mb-8">
        <div class="bg-white rounded-2xl p-5 border border-teal-100/80">
          <p class="font-display font-bold text-slate-900 mb-1">🛡️ Fasilitas Ramah Anak</p>
          <p class="text-xs text-slate-600 leading-relaxed">Akses lingkungan terkontrol, furnitur aman bagi anak, serta area bermain terpantau.</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-teal-100/80">
          <p class="font-display font-bold text-slate-900 mb-1">🧼 Kebersihan Harian</p>
          <p class="text-xs text-slate-600 leading-relaxed">Ruang kelas dan area sanitasi dibersihkan rutin dengan kebiasaan cuci tangan setiap hari.</p>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-teal-100/80">
          <p class="font-display font-bold text-slate-900 mb-1">💛 Pendampingan & P3K</p>
          <p class="text-xs text-slate-600 leading-relaxed">Tenaga pendidik sigap menjaga kesehatan fisik maupun kenyamanan emosional anak.</p>
        </div>
      </div>

      <a
        href="/id/health-and-safety"
        class="inline-flex items-center gap-2 rounded-full bg-teal-600 hover:bg-teal-700 text-white text-sm font-bold px-6 py-3 transition shadow-sm"
      >
        Lihat Standar Keselamatan Kami →
      </a>
    </div>
  </section>

  {/* 4. Cuplikan Kontak & Kunjungan Sekolah */}
  <section class="max-w-6xl mx-auto px-6 pt-8 pb-4">
    <div class="bg-gradient-to-r from-amber-400 to-amber-300 rounded-[2.5rem] p-8 md:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8 shadow-md shadow-amber-900/5">
      <div class="max-w-xl">
        <h2 class="font-display text-3xl font-bold text-slate-900 mb-3">
          Jadwalkan Kunjungan ke Tunas Gama School
        </h2>
        <p class="text-sm md:text-base text-slate-800 mb-4">
          Kunjungi kampus kami di Gianyar, berdiskusi langsung dengan guru, dan lihat suasana kelas secara langsung.
        </p>
        <p class="text-xs font-semibold text-slate-800">
          📍 {settings?.contactInfo?.address || 'Jl. Astina Sel. No.20, Bitera, Kec. Gianyar, Bali'}
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a
          href="/id/contacts"
          class="rounded-full bg-slate-900 hover:bg-slate-800 text-white text-sm font-bold px-7 py-3.5 transition shadow-sm"
        >
          Hubungi & Jadwalkan Kunjungan
        </a>
      </div>
    </div>
  </section>
</BaseLayout>