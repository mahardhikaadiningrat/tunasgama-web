---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/PageSections.astro';
import { getPageBySlug, urlFor } from '../lib/sanity';

const page = await getPageBySlug('home', 'en');
---

<BaseLayout title="Home" lang="en" currentPath="/">
  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto px-6 pt-12 pb-16">
    <div class="grid md:grid-cols-12 gap-10 items-center">
      <div class="md:col-span-7 space-y-6">
        <span class="inline-flex items-center gap-2 bg-amber-100 text-amber-800 text-xs font-bold px-4 py-1.5 rounded-full">
          ✨ Montessori & Merdeka Belajar in Gianyar – Bali
        </span>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-slate-800 leading-tight">
          Where Curiosity Meets <span class="text-teal-600">Creativity</span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed">
          {page?.heroSubtitle || "Welcome to a vibrant educational journey where curiosity meets creativity, and every child's unique brilliance is celebrated!"}
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a href="/programs" class="bg-amber-400 hover:bg-amber-500 text-slate-900 font-bold px-6 py-3.5 rounded-full shadow-lg shadow-amber-400/30 transition">
            Explore Programs
          </a>
          <a href="/contacts" class="bg-white hover:bg-teal-50 text-teal-700 border-2 border-teal-200 font-bold px-6 py-3.5 rounded-full transition">
            Schedule a Visit
          </a>
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="relative">
          <div class="absolute -inset-3 bg-gradient-to-tr from-amber-300 to-teal-300 rounded-[3rem] rotate-3 opacity-40"></div>
          {page?.heroImage ? (
            <img
              src={urlFor(page.heroImage).width(700).url()}
              alt="Tunas Gama School Students"
              class="relative rounded-[2.5rem] border-4 border-white shadow-xl w-full aspect-[4/3] object-cover"
            />
          ) : (
            <div class="relative rounded-[2.5rem] bg-amber-100 border-4 border-white shadow-xl aspect-[4/3] flex items-center justify-center text-amber-700 font-display text-xl">
              Upload Hero Image in Sanity
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {page?.sections && <PageSections sections={page.sections} lang="en" />}
</BaseLayout>